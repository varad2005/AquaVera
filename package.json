{
  "name": "aquavera",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npx -y pnpm install",
    "dev:frontend": "npx -y pnpm --filter frontend run dev",
    "dev:backend": "npx -y pnpm --filter backend run dev",
    "dev": "npx -y concurrently \"npm run dev:frontend\" \"npm run dev:backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
